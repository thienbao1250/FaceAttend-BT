# .env.example — Sao chép file này thành .env và điền giá trị thực
# KHÔNG commit file .env thật lên Git

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL (production / staging):
# DATABASE_URL=postgresql+psycopg2://faceattend_user:your_password@localhost:5432/faceattend_db

# Nếu không set → tự động dùng SQLite tại data/faceattend.db (chỉ dev/test)

# ---------------------------------------------------------------------------
# AI Models (đường dẫn tương đối từ root project)
# ---------------------------------------------------------------------------
# SCRFD_MODEL_PATH=models/det_10g.onnx
# ARCFACE_MODEL_PATH=models/w600k_r50.onnx
# ARCFACE_MODEL_VERSION=1.0

# ---------------------------------------------------------------------------
# Attendance service
# ---------------------------------------------------------------------------
# COOLDOWN_SECONDS=30
# MIN_TOGGLE_SECONDS=60

# ---------------------------------------------------------------------------
# Mã công ty — dùng làm tiền tố mã nhân viên
# Công thức: <COMPANY_CODE>-<YYYY>-<NNNN>
# Ví dụ:     FA-2026-0001, FA-2026-0002, ...
# ---------------------------------------------------------------------------
# COMPANY_CODE=FA

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
